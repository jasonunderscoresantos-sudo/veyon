#pragma once

#define VEYON_VERSION "@VERSION_STRING@"
#define VEYON_VERSION_MAJOR @VERSION_MAJOR@
#define VEYON_VERSION_MINOR @VERSION_MINOR@
#define VEYON_PLUGIN_DIR "@VEYON_PLUGIN_DIR@"
