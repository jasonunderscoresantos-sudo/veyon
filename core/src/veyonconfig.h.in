// NextSpace public release identity, separate from the upstream-compatible VEYON_VERSION* values above
#define NEXTSPACE_VERSION "@NEXTSPACE_VERSION@"
#define NEXTSPACE_VERSION_MAJOR @NEXTSPACE_VERSION_MAJOR@
#define NEXTSPACE_VERSION_MINOR @NEXTSPACE_VERSION_MINOR@
