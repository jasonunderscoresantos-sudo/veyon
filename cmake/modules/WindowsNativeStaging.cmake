# WindowsNativeStaging.cmake - NextSpace native Windows (MSYS2 UCRT64) staging
#
# description: script-mode counterpart of the cross-build windows-binaries recipe in WindowsInstaller.cmake.
#              Seeds the stage from the build tree, the vendored ddengine, the local Interception SDK and the
#              Qt plugin directory, then copies every non-system PE dependency from the explicit toolchain/SDK
#              roots. Nothing is resolved through PATH, and no shell tool is used.
# usage: cmake -DSOURCE_DIR=... -DBINARY_DIR=... -DSTAGE_NAME=... -DWINDOWS_ARCH=win64|win32
#              -DDDENGINE_DLL=... -DINTERCEPTION_DIR=... -DTOOLCHAIN_BIN_DIR=... -DQT_PLUGIN_DIR=...
#              -DOBJDUMP=... -DSTRIP=... -DWITH_TRANSLATIONS=ON|OFF -DWITH_WEBAPI=ON|OFF
#              -P WindowsNativeStaging.cmake

cmake_minimum_required(VERSION 3.21)

# tools are run by absolute path only; an empty PATH rules out any ambient lookup
set(ENV{PATH} "")

foreach(var SOURCE_DIR BINARY_DIR STAGE_NAME WINDOWS_ARCH DDENGINE_DLL INTERCEPTION_DIR TOOLCHAIN_BIN_DIR QT_PLUGIN_DIR OBJDUMP STRIP WITH_WEBAPI)
	if("${${var}}" STREQUAL "")
		message(FATAL_ERROR "WindowsNativeStaging: ${var} is not set")
	endif()
endforeach()
foreach(var SOURCE_DIR BINARY_DIR DDENGINE_DLL INTERCEPTION_DIR TOOLCHAIN_BIN_DIR QT_PLUGIN_DIR OBJDUMP STRIP)
	cmake_path(SET ${var} NORMALIZE "${${var}}")
	string(REGEX REPLACE "/$" "" ${var} "${${var}}")
endforeach()

set(SYSTEM_DIR "$ENV{SystemRoot}/System32")
cmake_path(SET SYSTEM_DIR NORMALIZE "${SYSTEM_DIR}")
foreach(dir SOURCE_DIR BINARY_DIR INTERCEPTION_DIR TOOLCHAIN_BIN_DIR QT_PLUGIN_DIR SYSTEM_DIR)
	if(NOT IS_DIRECTORY "${${dir}}")
		message(FATAL_ERROR "WindowsNativeStaging: ${dir} '${${dir}}' does not exist")
	endif()
endforeach()
foreach(file "${DDENGINE_DLL}" "${INTERCEPTION_DIR}/interception.dll" "${OBJDUMP}" "${STRIP}")
	if(NOT EXISTS "${file}")
		message(FATAL_ERROR "WindowsNativeStaging: required file '${file}' does not exist")
	endif()
endforeach()

if(WINDOWS_ARCH STREQUAL "win64")
	set(PE_FORMAT "pei-x86-64")
elseif(WINDOWS_ARCH STREQUAL "win32")
	set(PE_FORMAT "pei-i386")
else()
	message(FATAL_ERROR "WindowsNativeStaging: unknown WINDOWS_ARCH '${WINDOWS_ARCH}'")
endif()

# only the exact computed stage directory directly inside the build tree may be recreated
if(NOT STAGE_NAME MATCHES "^veyon-win(32|64)-[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" OR NOT STAGE_NAME MATCHES "^veyon-${WINDOWS_ARCH}-")
	message(FATAL_ERROR "WindowsNativeStaging: refusing unexpected stage name '${STAGE_NAME}'")
endif()
set(STAGE "${BINARY_DIR}/${STAGE_NAME}")
cmake_path(GET STAGE PARENT_PATH stage_parent)
if(NOT stage_parent STREQUAL BINARY_DIR)
	message(FATAL_ERROR "WindowsNativeStaging: stage '${STAGE}' is not a direct child of '${BINARY_DIR}'")
endif()
message(STATUS "WindowsNativeStaging: staging ${STAGE}")
file(REMOVE_RECURSE "${STAGE}")
file(MAKE_DIRECTORY "${STAGE}/plugins")

set(REPORT "# WindowsNativeStaging report for ${STAGE_NAME}\n")
foreach(var SOURCE_DIR BINARY_DIR TOOLCHAIN_BIN_DIR QT_PLUGIN_DIR INTERCEPTION_DIR DDENGINE_DLL OBJDUMP STRIP SYSTEM_DIR PE_FORMAT WITH_TRANSLATIONS WITH_WEBAPI)
	string(APPEND REPORT "# ${var}: ${${var}}\n")
endforeach()
string(APPEND REPORT "# PATH during staging: cleared; tools run by absolute path\n")

function(stage_file source destination)
	if(NOT EXISTS "${source}")
		message(FATAL_ERROR "WindowsNativeStaging: missing payload '${source}'")
	endif()
	if(EXISTS "${STAGE}/${destination}")
		message(FATAL_ERROR "WindowsNativeStaging: duplicate stage entry '${destination}' from '${source}'")
	endif()
	get_filename_component(dir "${STAGE}/${destination}" DIRECTORY)
	file(MAKE_DIRECTORY "${dir}")
	file(COPY_FILE "${source}" "${STAGE}/${destination}")
	set(REPORT "${REPORT}seed\t${destination}\t${source}\n" PARENT_SCOPE)
endfunction()

# file(WRITE) translates newlines on Windows, so CRLF output is written explicitly with NEWLINE_STYLE;
# the guard ensures file(CONFIGURE) has nothing to substitute
function(stage_crlf source destination)
	file(READ "${source}" content)
	string(REPLACE "\r\n" "\n" content "${content}")
	if(content MATCHES "@[A-Za-z0-9_/.+-]+@" OR content MATCHES "#cmakedefine")
		message(FATAL_ERROR "WindowsNativeStaging: '${source}' contains configure syntax and cannot be copied as text")
	endif()
	file(CONFIGURE OUTPUT "${STAGE}/${destination}" CONTENT "${content}" @ONLY NEWLINE_STYLE CRLF)
	set(REPORT "${REPORT}crlf\t${destination}\t${source}\n" PARENT_SCOPE)
endfunction()

# little-endian 32-bit value at a byte offset of a file
function(read_le32 file offset out)
	file(READ "${file}" hex OFFSET ${offset} LIMIT 4 HEX)
	string(REGEX REPLACE "^(..)(..)(..)(..)$" "\\4\\3\\2\\1" hex "${hex}")
	math(EXPR value "0x${hex}")
	set(${out} "${value}" PARENT_SCOPE)
endfunction()

# project-built binaries, flattened like the cross recipe: executables from below the build root,
# core, and plugin-tree DLLs (lib*.dll and vnchooks.dll at the root, all others in plugins/)
file(GLOB_RECURSE candidates LIST_DIRECTORIES false RELATIVE "${BINARY_DIR}" "${BINARY_DIR}/*.exe" "${BINARY_DIR}/*.dll")
list(SORT candidates)
set(BUILT_FILES "")
foreach(rel IN LISTS candidates)
	if(rel MATCHES "(^|/)CMakeFiles/" OR rel MATCHES "^veyon-win(32|64)-")
		continue()
	endif()
	get_filename_component(name "${rel}" NAME)
	string(TOLOWER "${name}" lname)
	if(rel MATCHES "/veyon-[^/]+\\.exe$" OR rel STREQUAL "core/veyon-core.dll")
		set(destination "${name}")
	elseif(rel MATCHES "^plugins/.+\\.dll$")
		if(lname MATCHES "^lib" OR lname STREQUAL "vnchooks.dll")
			set(destination "${name}")
		else()
			set(destination "plugins/${name}")
		endif()
	else()
		continue()
	endif()
	stage_file("${BINARY_DIR}/${rel}" "${destination}")
	list(APPEND BUILT_FILES "${destination}")
endforeach()
foreach(required "veyon-core.dll" "vnchooks.dll" "veyon-master.exe")
	if(NOT required IN_LIST BUILT_FILES)
		message(FATAL_ERROR "WindowsNativeStaging: build output '${required}' is missing")
	endif()
endforeach()

if(WITH_TRANSLATIONS)
	file(GLOB qm_files "${BINARY_DIR}/translations/*.qm")
	if(NOT qm_files)
		message(FATAL_ERROR "WindowsNativeStaging: WITH_TRANSLATIONS is enabled but no .qm file was built")
	endif()
	foreach(qm IN LISTS qm_files)
		get_filename_component(name "${qm}" NAME)
		stage_file("${qm}" "translations/${name}")
	endforeach()
else()
	string(APPEND REPORT "# translations: not staged (WITH_TRANSLATIONS=OFF)\n")
endif()

# vendored and SDK runtime payload
get_filename_component(ddengine_name "${DDENGINE_DLL}" NAME)
stage_file("${DDENGINE_DLL}" "${ddengine_name}")
stage_file("${INTERCEPTION_DIR}/interception.dll" "interception.dll")

# NextSpace controlled Interception payload (GC3-S3): exactly the three canonical files from 3rdparty/interception/
set(CANONICAL_INTERCEPTION_DIR "${SOURCE_DIR}/3rdparty/interception")
set(CANONICAL_HELPER_SHA256 "98B4B384BC2C84A9E9F9275352B265DD1B351C4780598D7D1AA7D32B06F5BA86")
set(CANONICAL_INSTALL_BAT_SHA256 "77048165377633E8CB5FDBD62C313493BD19E4CDCB0F9CF5BDAEDB88D7BCD105")
set(CANONICAL_UNINSTALL_BAT_SHA256 "3CA834971CE2364F53FEF24582C368BD14ECC5F4D8B620FFB04332C2BFC11FA8")

file(GLOB actual_interception_files LIST_DIRECTORIES false "${CANONICAL_INTERCEPTION_DIR}/*")
set(actual_interception_names "")
foreach(actual_interception_file IN LISTS actual_interception_files)
	get_filename_component(actual_interception_name "${actual_interception_file}" NAME)
	list(APPEND actual_interception_names "${actual_interception_name}")
endforeach()
list(SORT actual_interception_names)
set(expected_interception_names "install-interception.exe;install.bat;uninstall.bat")
if(NOT actual_interception_names STREQUAL expected_interception_names)
	message(FATAL_ERROR
		"WindowsNativeStaging: 3rdparty/interception must contain exactly "
		"${expected_interception_names}; found ${actual_interception_names}"
	)
endif()

file(REAL_PATH "${CANONICAL_INTERCEPTION_DIR}" canonical_interception_real_dir)

function(stage_canonical_interception filename expected_size expected_hash)
	set(file_path "${CANONICAL_INTERCEPTION_DIR}/${filename}")
	if(NOT EXISTS "${file_path}")
		message(FATAL_ERROR "WindowsNativeStaging: missing canonical payload '${file_path}'")
	endif()
	if(IS_SYMLINK "${file_path}")
		message(FATAL_ERROR "WindowsNativeStaging: symlink rejected for canonical payload '${file_path}'")
	endif()
	file(REAL_PATH "${file_path}" file_real_path)
	string(FIND "${file_real_path}" "${canonical_interception_real_dir}/" file_prefix)
	if(NOT file_prefix EQUAL 0)
		message(FATAL_ERROR "WindowsNativeStaging: canonical payload escaped its source directory: '${file_real_path}'")
	endif()
	file(SIZE "${file_path}" actual_size)
	if(NOT actual_size EQUAL expected_size)
		message(FATAL_ERROR "WindowsNativeStaging: size mismatch for '${filename}': expected ${expected_size}, got ${actual_size}")
	endif()
	file(SHA256 "${file_path}" actual_hash)
	string(TOUPPER "${actual_hash}" actual_hash)
	if(NOT actual_hash STREQUAL expected_hash)
		message(FATAL_ERROR "WindowsNativeStaging: SHA-256 mismatch for '${filename}': expected ${expected_hash}, got ${actual_hash}")
	endif()
	stage_file("${file_path}" "interception/${filename}")
	set(REPORT "${REPORT}interception\tinterception/${filename}\t${actual_hash}\n" PARENT_SCOPE)
endfunction()

stage_canonical_interception("install-interception.exe" 470528 "${CANONICAL_HELPER_SHA256}")
stage_canonical_interception("install.bat" 150 "${CANONICAL_INSTALL_BAT_SHA256}")
stage_canonical_interception("uninstall.bat" 53 "${CANONICAL_UNINSTALL_BAT_SHA256}")
stage_file("${BINARY_DIR}/nextspace-interception-payload.tsv" "nextspace-interception-payload.tsv")

# Qt dynamic plugins and the QCA OpenSSL provider, as listed in veyon.nsi
foreach(plugin "platforms/qwindows.dll" "imageformats/qjpeg.dll" "tls/qopensslbackend.dll" "crypto/libqca-ossl.dll")
	stage_file("${QT_PLUGIN_DIR}/${plugin}" "${plugin}")
endforeach()
file(GLOB styles LIST_DIRECTORIES false "${QT_PLUGIN_DIR}/styles/*.dll")
if(NOT styles)
	message(FATAL_ERROR "WindowsNativeStaging: no Qt style plugin in '${QT_PLUGIN_DIR}/styles'")
endif()
foreach(style IN LISTS styles)
	get_filename_component(name "${style}" NAME)
	stage_file("${style}" "styles/${name}")
endforeach()

# legal/readme files and NSIS sources (makensis is not run here)
stage_file("${SOURCE_DIR}/COPYING" "COPYING")
stage_crlf("${SOURCE_DIR}/COPYING" "LICENSE.TXT")
stage_crlf("${SOURCE_DIR}/nsis/README-nextspace.txt" "README.TXT")
stage_file("${SOURCE_DIR}/THIRD-PARTY-NOTICES.txt" "THIRD-PARTY-NOTICES.txt")
# NextSpace offline help (GC3-S2): exactly the two bundled files, copied unchanged into help/
stage_file("${SOURCE_DIR}/doc/nextspace-help/index.html" "help/index.html")
stage_file("${SOURCE_DIR}/doc/nextspace-help/quick-reference.txt" "help/quick-reference.txt")
file(COPY "${SOURCE_DIR}/nsis" DESTINATION "${STAGE}")
string(APPEND REPORT "seed\tnsis/\t${SOURCE_DIR}/nsis\n")
stage_file("${BINARY_DIR}/nsis/veyon.nsi" "veyon.nsi")

# runtime dependency closure; supplier names are matched case-insensitively
file(GLOB toolchain_dlls LIST_DIRECTORIES false "${TOOLCHAIN_BIN_DIR}/*.dll")
file(GLOB sdk_dlls LIST_DIRECTORIES false "${INTERCEPTION_DIR}/*.dll")
foreach(file IN LISTS toolchain_dlls sdk_dlls)
	get_filename_component(name "${file}" NAME)
	string(TOLOWER "${name}" lname)
	if(DEFINED supplier_${lname})
		file(SHA256 "${file}" new_hash)
		file(SHA256 "${supplier_${lname}}" old_hash)
		if(NOT new_hash STREQUAL old_hash)
			set(conflict_${lname} "${supplier_${lname}} and ${file}")
		endif()
	else()
		set(supplier_${lname} "${file}")
	endif()
endforeach()

file(GLOB_RECURSE queue LIST_DIRECTORIES false RELATIVE "${STAGE}" "${STAGE}/*.exe" "${STAGE}/*.dll")
list(SORT queue)
set(unresolved "")
list(LENGTH queue pending_count)
while(pending_count GREATER 0)
	list(POP_FRONT queue rel)
	# The vendor's command-line driver helper is intentionally a 32-bit PE and
	# is not a NextSpace runtime binary. Keep it hash-manifested, but outside
	# the x64 runtime dependency closure just like the cross-build recipe does.
	if(rel MATCHES "^interception/")
		string(APPEND REPORT "helper\t${rel}\texcluded-from-${PE_FORMAT}-runtime-closure\n")
		list(LENGTH queue pending_count)
		continue()
	endif()
	execute_process(COMMAND "${OBJDUMP}" -p "${STAGE}/${rel}"
		OUTPUT_VARIABLE dump ERROR_VARIABLE dump_error RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "WindowsNativeStaging: objdump failed for '${rel}': ${dump_error}")
	endif()
	string(REGEX MATCH "file format ([^\r\n]+)" format_line "${dump}")
	set(format "${CMAKE_MATCH_1}")
	if(NOT format STREQUAL PE_FORMAT)
		message(FATAL_ERROR "WindowsNativeStaging: '${rel}' has machine format '${format}', expected '${PE_FORMAT}'")
	endif()
	string(APPEND REPORT "pe\t${rel}\t${format}\n")
	string(REGEX MATCHALL "DLL Name: [^\r\n]+" entries "${dump}")
	foreach(entry IN LISTS entries)
		string(REGEX REPLACE "^DLL Name: " "" name "${entry}")
		string(STRIP "${name}" name)
		string(TOLOWER "${name}" lname)
		set(source "")
		if(lname MATCHES "^(api-ms-|ext-ms-)")
			set(resolution "apiset")
		elseif(EXISTS "${STAGE}/${name}")
			set(resolution "stage")
		elseif(DEFINED supplier_${lname})
			if(DEFINED conflict_${lname} OR EXISTS "${SYSTEM_DIR}/${name}")
				message(FATAL_ERROR "WindowsNativeStaging: dependency conflict for '${name}' (${conflict_${lname}}${supplier_${lname}} vs. ${SYSTEM_DIR})")
			endif()
			set(source "${supplier_${lname}}")
			get_filename_component(supplied_name "${source}" NAME)
			file(COPY_FILE "${source}" "${STAGE}/${supplied_name}")
			list(APPEND queue "${supplied_name}")
			set(resolution "copied")
		elseif(EXISTS "${SYSTEM_DIR}/${name}")
			set(resolution "system32")
		else()
			set(resolution "UNRESOLVED")
			list(APPEND unresolved "${rel} -> ${name}")
		endif()
		string(APPEND REPORT "import\t${rel}\t${name}\t${resolution}\t${source}\n")
	endforeach()
	list(LENGTH queue pending_count)
endwhile()
if(unresolved)
	file(WRITE "${STAGE}-staging-report.tsv" "${REPORT}")
	list(JOIN unresolved "\n  " unresolved_text)
	message(FATAL_ERROR "WindowsNativeStaging: unresolved non-system imports:\n  ${unresolved_text}")
endif()

# with WITH_WEBAPI=OFF neither the WebAPI plugin nor its HTTP server runtime may enter the stage
# (for example from a stale plugin left in a reused build tree)
if(WITH_WEBAPI)
	string(APPEND REPORT "# webapi: permitted (WITH_WEBAPI=${WITH_WEBAPI})\n")
else()
	file(GLOB_RECURSE staged_payload LIST_DIRECTORIES false RELATIVE "${STAGE}" "${STAGE}/*")
	list(SORT staged_payload)
	set(webapi_payload "")
	foreach(rel IN LISTS staged_payload)
		get_filename_component(name "${rel}" NAME)
		string(TOLOWER "${name}" lname)
		if(lname MATCHES "webapi" OR lname MATCHES "httpserver")
			list(APPEND webapi_payload "${rel}")
		endif()
	endforeach()
	if(webapi_payload)
		file(WRITE "${STAGE}-staging-report.tsv" "${REPORT}")
		list(JOIN webapi_payload "\n  " webapi_text)
		message(FATAL_ERROR "WindowsNativeStaging: WebAPI payload staged although WITH_WEBAPI=${WITH_WEBAPI}:\n  ${webapi_text}")
	endif()
	string(APPEND REPORT "# webapi: not staged (WITH_WEBAPI=${WITH_WEBAPI})\n")
endif()

# strip only project-built binaries; redistributed binaries stay byte-identical to their sources.
# strip stamps the PE header with SOURCE_DATE_EPOCH or the current time, so keep the linker's timestamp
# to make the result reproducible from the build tree
foreach(rel IN LISTS BUILT_FILES)
	read_le32("${STAGE}/${rel}" 60 pe_header)
	math(EXPR timestamp_offset "${pe_header} + 8")
	read_le32("${STAGE}/${rel}" ${timestamp_offset} linker_timestamp)
	set(ENV{SOURCE_DATE_EPOCH} "${linker_timestamp}")
	execute_process(COMMAND "${STRIP}" "${STAGE}/${rel}" ERROR_VARIABLE strip_error RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "WindowsNativeStaging: strip failed for '${rel}': ${strip_error}")
	endif()
	string(APPEND REPORT "strip\t${rel}\tSOURCE_DATE_EPOCH=${linker_timestamp}\n")
endforeach()
unset(ENV{SOURCE_DATE_EPOCH})

file(WRITE "${STAGE}-staging-report.tsv" "${REPORT}")
file(GLOB_RECURSE staged LIST_DIRECTORIES false "${STAGE}/*")
list(LENGTH staged staged_count)
message(STATUS "WindowsNativeStaging: staged ${staged_count} files in ${STAGE_NAME}; report ${STAGE}-staging-report.tsv")
